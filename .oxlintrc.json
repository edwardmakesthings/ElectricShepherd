{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    ".opencode/**",
    ".electric-shepherd/**",
    "coverage/**",
    "dist/**",
    "build/**"
  ],
  "rules": {
    "no-debugger": "error",
    "no-duplicate-imports": "error",
    "no-unreachable": "error",
    "eqeqeq": [
      "error",
      "always"
    ],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  }
}
