# ElectricShepherd secrets-only env template.
#
# Runtime behavior now lives in:
#   .electric-shepherd/config.jsonc
# (copy from electric-shepherd.config.example.jsonc)
#
# Keep ONLY credentials/tokens in .env.

# Optional explicit env file override for runtime scripts.
# ESHEPHERD_ENV_FILE=/absolute/path/to/custom.env

# Optional MCP auth values (secrets).
MEMPALACE_MCP_API_KEY=
MEMPALACE_MCP_BEARER_TOKEN=

# Optional raw header map. Treat as secret if it includes credentials.
MEMPALACE_MCP_HEADERS_JSON=